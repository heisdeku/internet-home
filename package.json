{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "run-p --print-label dev:*",
    "dev:web": "bun run --cwd web dev",
    "dev:studio": "bun run --cwd studio dev",
    "build": "bun run --cwd web build",
    "start": "node web/dist/server/entry.mjs",
    "typegen": "bun run --cwd studio typegen",
    "schema:deploy": "bun run --cwd studio schema:deploy"
  },
  "devDependencies": {
    "npm-run-all2": "^5.0.2"
  },
  "dependencies": {
    "@sanity/client": "^8.10.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "bun@1.3.4"
}
