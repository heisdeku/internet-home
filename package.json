{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "npx run-p --print-label dev:*",
    "dev:web": "npm run dev --workspace=web",
    "dev:studio": "npm run dev --workspace=studio",
    "build": "npm run build --workspace=web",
    "typegen": "npm run typegen --workspace=studio",
    "seed": "npm run seed --workspace=studio",
    "schema:deploy": "npm run schema:deploy --workspace=studio",
    "start": "node web/dist/server/entry.mjs"
  },
  "devDependencies": {
    "npm-run-all2": "^5.0.2"
  },
  "dependencies": {
    "@sanity/client": "^8.10.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
