---
import BrandLink from "@/components/BrandLink.astro";
import Heading from "@/components/Heading.astro";
import { toolIcon } from "@/lib/toolIcons";
import type { Section } from "@/components/PageBuilder.astro";
import PortableText from "@/components/portable-text/PortableText.astro";
import SmartLink from "@/components/SmartLink.astro";

interface Props {
  section: Extract<Section, { _type: "infoSection" }>;
  resumeUrl: string | null;
}

const { section, resumeUrl } = Astro.props;
---

<section
  id="info"
  data-reveal-stagger
  data-reveal-step="140"
  style="--reveal-duration:.9s"
  class="px-gutter grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-12 border-t border-line py-[clamp(64px,8vw,120px)]"
>
  <Heading value={section.heading} size="XS" />
  <div class="col-span-2 flex flex-col gap-14">
    <div
      class="flex max-w-[62ch] flex-col gap-4 text-[13px] leading-[1.6] text-ink-soft md:text-[15px]"
    >
      <PortableText value={section.body} />
    </div>
    {
      section.columns && section.columns.length > 0 && (
        <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-10 text-sm">
          {section.columns.map((column) => (
            <div class="flex flex-col gap-3.5" data-reveal-stagger data-reveal-step="60">
              <span class="label">{column.label}</span>
              {column.source === "experience"
                ? section.companies.map((item) => (
                    <BrandLink
                      label={item.company ?? ""}
                      href={item.url}
                      logoUrl={item.logo}
                      color={item.brandColor}
                      mode="slide"
                      class="border-b border-line-soft pb-3"
                    />
                  ))
                : (column.items ?? []).map((item) => {
                    const icon = toolIcon(item);
                    return (
                      <BrandLink label={item} path={icon?.path} color={icon?.hex} mode="slide" class="border-b border-line-soft pb-3" />
                    );
                  })}
              {column.link && (
                <SmartLink
                  link={column.link}
                  resumeUrl={resumeUrl}
                  icon="auto"
                  class="font-medium text-accent"
                />
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
