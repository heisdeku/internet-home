<aside aria-label="Now playing" transition:persist>
  <a
    data-listening-now
    href="https://open.spotify.com/"
    target="_blank"
    rel="noopener"
    class="group/np hidden data-mode:grid fixed bottom-[clamp(12px,2vw,24px)] left-[clamp(12px,2vw,24px)] z-20 w-[min(300px,calc(100vw-24px))] grid-cols-[52px_minmax(0,1fr)] gap-3 rounded-lg bg-ink p-2.5 text-paper shadow-[0_10px_30px_rgba(0,0,0,.18)] hover:text-paper"
  >
    <img
      data-art
      alt=""
      width="52"
      height="52"
      decoding="async"
      class="size-13 rounded bg-[#232321] object-cover"
    />
    <div class="flex min-w-0 flex-col justify-center gap-1.5">
      <div class="flex items-center gap-2 font-mono text-[11px] tracking-[.06em] text-mist uppercase">
        <span
          class="flex h-2.5 items-end gap-0.5 group-data-[mode=last]/np:hidden"
          aria-hidden="true"
        >
          <span class="w-0.5 h-2.5 origin-bottom bg-accent-light animate-eq"></span>
          <span class="w-0.5 h-2.5 origin-bottom bg-accent-light animate-eq [animation-delay:.2s]"></span>
          <span class="w-0.5 h-2.5 origin-bottom bg-accent-light animate-eq [animation-delay:.4s]"></span>
        </span>
        <span data-label>Listening now</span>
      </div>
      <span data-title class="truncate text-[13px] font-medium"></span>
      <div class="flex items-center gap-2 text-[11px] text-mist">
        <span data-artist class="flex-1 truncate"></span>
        <span data-elapsed class="font-mono"></span>
      </div>
      <div class="h-0.5 overflow-hidden rounded-sm bg-body group-data-[mode=last]/np:hidden">
        <div
          data-progress
          class="h-full bg-accent-light"
          style="width:0%"
        ></div>
      </div>
    </div>
  </a>
</aside>

<script>
  import type { NowPlaying } from "@/pages/api/now-playing.json";

  document.addEventListener("astro:page-load", () => {
    const card = document.querySelector<HTMLAnchorElement>(
      "[data-listening-now]:not([data-ready])",
    );
    if (!card) return;
    card.dataset.ready = "";
    start(card);
  });

  function start(card: HTMLAnchorElement) {
    const art = card.querySelector<HTMLImageElement>("[data-art]")!;
    const title = card.querySelector("[data-title]")!;
    const artist = card.querySelector("[data-artist]")!;
    const elapsed = card.querySelector("[data-elapsed]")!;
    const progress = card.querySelector<HTMLElement>("[data-progress]")!;

    const label = card.querySelector("[data-label]")!;
    let track: Extract<NowPlaying, { isPlaying: true }> | null = null;
    let fetchedAt = 0;

    const mmss = (ms: number) => {
      const s = Math.floor(ms / 1000);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    };

    const ago = (iso: string) => {
      const minutes = Math.max(
        1,
        Math.round((Date.now() - new Date(iso).getTime()) / 60_000),
      );
      if (minutes < 60) return `${minutes} min ago`;
      const hours = Math.round(minutes / 60);
      if (hours < 24) return `${hours} h ago`;
      return `${Math.round(hours / 24)} d ago`;
    };
    const show = (
      data:
        | Extract<NowPlaying, { isPlaying: true }>
        | NonNullable<Extract<NowPlaying, { isPlaying: false }>["lastPlayed"]>,
    ) => {
      card.href = data.url;
      art.src = data.albumArt;
      title.textContent = data.title;
      artist.textContent = data.artist;
    };

    const paint = () => {
      if (!track) return;
      const position = Math.min(
        track.progressMs + (Date.now() - fetchedAt),
        track.durationMs,
      );
      elapsed.textContent = `${mmss(position)} / ${mmss(track.durationMs)}`;
      progress.style.width = `${(position / track.durationMs) * 100}%`;
    };

    const IDLE_MS = 30_000;
    const PLAYING_MS = 12_000;
    let timer = 0;
    const schedule = (ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(poll, ms);
    };

    const poll = async () => {
      if (document.hidden) return schedule(IDLE_MS);
      try {
        const response = await fetch("/api/now-playing.json");
        const data: NowPlaying = await response.json();
        if (!data.isPlaying) {
          track = null;
          if (!data.lastPlayed) {
            delete card.dataset.mode;
            return schedule(IDLE_MS);
          }
          show(data.lastPlayed);
          label.textContent = "Last played";
          elapsed.textContent = ago(data.lastPlayed.playedAt);
          card.dataset.mode = "last";
          return schedule(IDLE_MS);
        }
        track = data;
        fetchedAt = Date.now();
        show(data);
        label.textContent = "Listening now";
        paint();
        card.dataset.mode = "playing";
        const remaining = data.durationMs - data.progressMs;
        schedule(Math.max(1_500, Math.min(remaining + 1_200, PLAYING_MS)));
      } catch {
        delete card.dataset.mode;
        schedule(IDLE_MS);
      }
    };

    poll();
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) poll();
    });
    setInterval(paint, 1_000);
  }
</script>
