---
interface Props {
  label: string;
  href?: string | null;
  logoUrl?: string | null;
  path?: string | null;
  color?: string | null;
  mode?: "float" | "slide";
  class?: string;
}

const {
  label,
  href,
  logoUrl,
  path,
  color,
  mode = "float",
  class: className,
} = Astro.props;
const Tag = href ? "a" : "span";
const hasMark = Boolean(logoUrl || path);
---

<Tag
  href={href ?? undefined}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener" : undefined}
  class:list={[
    "brand-link",
    `brand-link-${mode}`,
    href && "hit",
    hasMark && "has-mark",
    path && "brand-link-ink",
    className,
  ]}
  style={color ? `--brand:${color}` : undefined}
>
  {
    hasMark && (
      <span class="brand-mark" aria-hidden="true">
        {logoUrl ? (
          <img src={logoUrl} alt="" loading="lazy" decoding="async" />
        ) : (
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d={path} />
          </svg>
        )}
      </span>
    )
  }
  <span>{label}<slot /></span>
</Tag>
