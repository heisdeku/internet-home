---
interface Props {
  value:
    | { text: string | null; type: string | null; fontSize: string | null }
    | null
    | undefined;
  class?: string;
  size?: Size;
}

type Size = "XS" | "S" | "M" | "L" | "XL" | "XXL" | "3XL";

const SIZE_CLASS: Record<Size, string> = {
  XS: "text-[13px] font-medium",
  S: "text-lg font-medium tracking-[-.01em]",
  M: "text-[clamp(20px,2vw,28px)] leading-[1.35] font-medium tracking-[-.015em]",
  L: "text-[26px] leading-[1.2] font-medium tracking-[-.02em]",
  XL: "text-[clamp(28px,3.6vw,52px)] leading-[1.08] font-medium tracking-[-.025em]",
  XXL: "text-[clamp(30px,4.6vw,68px)] leading-[1.05] font-medium tracking-[-.03em]",
  "3XL":
    "text-[clamp(44px,8vw,120px)] leading-[.95] font-medium tracking-[-.045em]",
};
const DEFAULT_SIZE: Record<string, Size> = {
  h1: "3XL",
  h2: "L",
  h3: "M",
  h4: "S",
  p: "M",
};

const SPLIT_SIZES = new Set<Size>(["XL", "XXL", "3XL"]);

function splitWords(markup: string) {
  let index = 0;
  let inWhole = false;
  return markup
    .split(/(<[^>]+>)/)
    .map((part) => {
      if (part.startsWith("<")) {
        if (/class="(sr-only|rotate-word)"/.test(part)) {
          inWhole = true;
          if (part.includes("rotate-word")) index++;
        } else if (part === "</span>") inWhole = false;
        return part;
      }
      if (inWhole) return part;
      return part.replace(
        /\S+/g,
        (word) =>
          `<span class="split-word" style="--i:${index++}">${word}</span>`,
      );
    })
    .join("");
}

const { value, class: className, size } = Astro.props;
const Tag = (value?.type ?? "h2") as "h1" | "h2" | "h3" | "h4" | "p";
const resolvedSize =
  (value?.fontSize as Size | null) ?? size ?? DEFAULT_SIZE[Tag];

const escaped = (value?.text ?? "")
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/&lt;span&gt;/g, '<span class="text-highlight">')
  .replace(/&lt;\/span&gt;/g, "</span>")
  .replace(/&lt;br\s*\/?&gt;/g, "<br />")

  .replace(
    /(\(?)&lt;rotate&gt;(.*?)&lt;\/rotate&gt;(\)?)/g,
    (_, open: string, words: string, close: string) => {
      const list = words.split("|").map((word) => word.trim());
      return `<span class="whitespace-nowrap">${open}<span class="sr-only">${list[0]}</span><span class="rotate-word" data-rotate data-words="${list.join("|")}" aria-hidden="true">${list[0]}</span>${close}</span>`;
    },
  );
  
const split = SPLIT_SIZES.has(resolvedSize);
const html = split ? splitWords(escaped) : escaped;
const label = split
  ? (value?.text ?? "")
      .replace(/<rotate>(.*?)<\/rotate>/g, (_, words: string) =>
        words.split("|")[0].trim(),
      )
      .replace(/<br\s*\/?>/g, " ")
      .replace(/<[^>]+>/g, "")
      .replace(/\s+/g, " ")
      .trim()
  : undefined;
---

{value?.text && (
  <Tag
    class:list={["text-pretty", SIZE_CLASS[resolvedSize], className]}
    aria-label={label}
    set:html={html}
  />
)}
