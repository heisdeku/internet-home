---
import Check from 'reicon-astro/icons/Check.astro';
import Copy from 'reicon-astro/icons/Copy.astro';

/**
 * The big email address: clicking it copies the address, and a helper pill to the right
 * says so, then confirms. If the clipboard is unavailable the click opens the mail client.
 */
interface Props {
	email: string;
	/** Optional subject for the mailto fallback. */
	subject?: string | null;
	class?: string;
}

const { email, subject, class: className } = Astro.props;
const mailto = `mailto:${email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
---

<span class="group/email flex flex-wrap items-baseline gap-x-5 gap-y-3">
	<a
		href={mailto}
		data-copy-email
		class:list={[
			'cursor-copy leading-none font-medium tracking-[-.04em] [overflow-wrap:anywhere] text-paper transition-colors hover:text-accent-light',
			className,
		]}
	>
		{email}
	</a>
	<span
		aria-live="polite"
		class="inline-flex items-center gap-1.5 self-center rounded-full border border-paper/20 px-2.5 py-1 font-mono text-[11px] tracking-[.04em] whitespace-nowrap text-mist transition-colors group-hover/email:border-accent-light group-hover/email:text-paper group-data-[copied]/email:border-accent-light group-data-[copied]/email:text-accent-light"
	>
		<Copy class="size-3.5 group-data-[copied]/email:hidden" aria-hidden="true" />
		<Check class="hidden size-3.5 group-data-[copied]/email:block" aria-hidden="true" />
		<span class="group-data-[copied]/email:hidden">Click to copy</span>
		<span class="hidden group-data-[copied]/email:inline">Copied</span>
	</span>
</span>

<script>
	import { startCopyEmail } from '@/scripts/copy';
	startCopyEmail();
</script>
