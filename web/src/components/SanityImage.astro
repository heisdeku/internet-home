---
import Placeholder from "@/components/Placeholder.astro";
import { urlFor, type SanityImageField } from "@/sanity/image";

interface Props {
  image: SanityImageField | null | undefined;
  placeholder: string;
  width: number;
  height: number;
  class?: string;
  priority?: boolean;
  sizes?: string;
  dark?: boolean;
}

const {
  image,
  placeholder,
  width,
  height,
  class: className,
  priority = false,
  sizes = "100vw",
  dark = false,
} = Astro.props;
const hasAsset = image?.asset != null;
const CANDIDATES = [480, 720, 960, 1200, 1440, 1920, 2400, 2880];
const ratio = height / width;
// Asset ids carry the original size (image-<hash>-<width>x<height>-<format>). Asking Sanity for
// more pixels than the crop holds only upscales, so the widest request is what the source has.
let maxWidth = width * 2;
if (image?.asset) {
  const [assetWidth, assetHeight] = image.asset._ref
    .split("-")[2]
    .split("x")
    .map(Number);
  const crop = image.crop ?? { left: 0, right: 0, top: 0, bottom: 0 };
  maxWidth = Math.floor(
    Math.min(
      maxWidth,
      assetWidth * (1 - crop.left - crop.right),
      (assetHeight * (1 - crop.top - crop.bottom)) / ratio,
    ),
  );
}
const widths = [...CANDIDATES.filter((w) => w < maxWidth), maxWidth];
const source = image?.asset
  ? urlFor({
      asset: image.asset,
      crop: image.crop ?? undefined,
      hotspot: image.hotspot ?? undefined,
    })
  : undefined;
const src = (w: number) =>
  source
    ? source
        .width(w)
        .height(Math.round(w * ratio))
        .fit("crop")
        .url()
    : "";
---

{hasAsset ? (
  <span
    class:list={["img-frame rounded bg-tile", className]}
    style={image.lqip ? `background-image:url(${image.lqip})` : undefined}
  >
    <img
      src={src(Math.min(width, maxWidth))}
      srcset={widths.map((w) => `${src(w)} ${w}w`).join(", ")}
      sizes={sizes}
      alt={image.alt ?? ""}
      width={width}
      height={height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding={priority ? undefined : "async"}
      data-fade-in={priority ? undefined : ""}
      class="object-cover"
    />
  </span>
) : (
  <Placeholder label={placeholder} class={className} dark={dark} />
)}
