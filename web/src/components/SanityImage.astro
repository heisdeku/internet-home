---
import { urlFor, type SanityImageSource } from '@/sanity/image';
import Placeholder from '@/components/Placeholder.astro';

/**
 * Renders a Sanity image over its pixelated LQIP, fading in once decoded, or
 * the striped placeholder when the field is empty. `class` is applied to both
 * branches so layouts match.
 */
interface Props {
	image: (SanityImageSource & { alt?: string | null; lqip?: string | null }) | null | undefined;
	placeholder: string;
	width: number;
	height: number;
	class?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	/** How wide the image renders, for the browser to pick a candidate. Defaults to the full viewport. */
	sizes?: string;
	dark?: boolean;
}

const { image, placeholder, width, height, class: className, loading = 'lazy', fetchpriority, sizes = '100vw', dark = false } = Astro.props;
const hasAsset = image != null && 'asset' in image && image.asset != null;
// Candidates up to twice the requested width, so a 420px card never downloads a 2240px file on a phone.
const CANDIDATES = [480, 720, 960, 1200, 1440, 1920, 2400];
const ratio = height / width;
const widths = CANDIDATES.filter((w) => w <= width * 2);
if (!widths.includes(width)) widths.push(width);
const src = (w: number) => (hasAsset ? urlFor(image).width(w).height(Math.round(w * ratio)).fit('crop').url() : '');
---

{
	hasAsset ? (
		<span
			class:list={['img-frame rounded bg-tile', className]}
			style={image.lqip ? `background-image:url(${image.lqip})` : undefined}
		>
			<img
				src={src(width)}
				srcset={widths.sort((a, b) => a - b).map((w) => `${src(w)} ${w}w`).join(', ')}
				sizes={sizes}
				alt={image.alt ?? ''}
				width={width}
				height={height}
				loading={loading}
				fetchpriority={fetchpriority}
				decoding="async"
				data-fade-in
				class="object-cover"
			/>
		</span>
	) : (
		<Placeholder label={placeholder} class={className} dark={dark} />
	)
}
