---
import Placeholder from "@/components/Placeholder.astro";
import { urlFor, type SanityImageSource } from "@/sanity/image";

interface Props {
  image:
    | (SanityImageSource & { alt?: string | null; lqip?: string | null })
    | null
    | undefined;
  placeholder: string;
  width: number;
  height: number;
  class?: string;
  priority?: boolean;
  sizes?: string;
  dark?: boolean;
}

const {
  image,
  placeholder,
  width,
  height,
  class: className,
  priority = false,
  sizes = "100vw",
  dark = false,
} = Astro.props;
const hasAsset = image != null && "asset" in image && image.asset != null;
const CANDIDATES = [480, 720, 960, 1200, 1440, 1920, 2400];
const ratio = height / width;
const widths = CANDIDATES.filter((w) => w <= width * 2);
if (!widths.includes(width)) widths.push(width);
const src = (w: number) =>
  hasAsset
    ? urlFor(image)
        .width(w)
        .height(Math.round(w * ratio))
        .fit("crop")
        .url()
    : "";
---

{
  hasAsset ? (
    <span
      class:list={["img-frame rounded bg-tile", className]}
      style={image.lqip ? `background-image:url(${image.lqip})` : undefined}
    >
      <img
        src={src(width)}
        srcset={widths
          .sort((a, b) => a - b)
          .map((w) => `${src(w)} ${w}w`)
          .join(", ")}
        sizes={sizes}
        alt={image.alt ?? ""}
        width={width}
        height={height}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding={priority ? undefined : "async"}
        data-fade-in={priority ? undefined : ""}
        class="object-cover"
      />
    </span>
  ) : (
    <Placeholder label={placeholder} class={className} dark={dark} />
  )
}
