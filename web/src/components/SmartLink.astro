---
import { opensInNewTab, resolveHref, type LinkData } from "@/sanity/links";
import ArrowDown from "reicon-astro/icons/ArrowDown.astro";
import ArrowRight from "reicon-astro/icons/ArrowRight.astro";
import ArrowUpRight from "reicon-astro/icons/ArrowUpRight.astro";

interface Props {
  link: LinkData;
  resumeUrl: string | null;
  class?: string;
  icon?: "auto" | "none";
  "aria-current"?: "page";
}

const {
  link,
  resumeUrl,
  class: className,
  icon = "none",
  "aria-current": ariaCurrent,
} = Astro.props;
const href = resolveHref(link, resumeUrl);
const newTab = opensInNewTab(link);
const comingSoon =
  link.type === "internal" && link.internal?.comingSoon === true;

const ICON_BY_TYPE = {
  external: { component: ArrowUpRight, nudge: "translate(3px, -3px)" },
  resume: { component: ArrowDown, nudge: "translateY(3px)" },
};
const trailing =
  icon === "auto"
    ? (ICON_BY_TYPE[link.type as keyof typeof ICON_BY_TYPE] ?? {
        component: ArrowRight,
        nudge: "translateX(4px)",
      })
    : null;
---

{href ? (
  <a
    href={href}
    class:list={[
      "hit",
      trailing && "group inline-flex items-center gap-1.5",
      className,
    ]}
    target={newTab ? "_blank" : undefined}
    rel={newTab ? "noopener" : undefined}
    aria-current={ariaCurrent}
  >
    <slot>{link.label}</slot>
    {trailing && (
      <trailing.component
        class="icon-inline"
        style={`--icon-nudge:${trailing.nudge}`}
      />
    )}
  </a>
) : (
  <span
    class:list={[
      "inline-flex items-center gap-2",
      comingSoon && "cursor-default text-(--tone-muted)",
      className,
    ]}
  >
    <slot>{link.label}</slot>
    {comingSoon ? (
      <span class="soon-badge">Coming soon</span>
    ) : (
      trailing && <trailing.component class="icon-inline" />
    )}
  </span>
)}
