---
import SanityImage from "@/components/SanityImage.astro";
import type { FigureImage } from "@/components/portable-text/Figure.astro";
import type { TypedObjectProps } from "astro-portabletext/types";

type Props = TypedObjectProps & {
  node: {
    images: (FigureImage & { _key: string })[];
    columns?: 2 | 3 | 4 | null;
  };
};

const { node } = Astro.props;
const columns = node.columns ?? 2;
const COLUMNS = {
  2: "md:grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-4",
};
const sizes = `(min-width: 768px) ${Math.round(100 / columns)}vw, ${columns > 2 ? 50 : 100}vw`;
const WIDTH = 900;
---

<div class:list={["my-2 grid items-start gap-3", COLUMNS[columns]]}>
  {node.images.map((image) => (
    <figure class="flex flex-col gap-2.5">
      <SanityImage
        image={image}
        placeholder="image"
        width={WIDTH}
        height={Math.round(WIDTH / (image.aspectRatio ?? 4 / 3))}
        sizes={sizes}
        class="w-full"
      />
      {image.caption && (
        <figcaption class="caption">{image.caption}</figcaption>
      )}
    </figure>
  ))}
</div>
