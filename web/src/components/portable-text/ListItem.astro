---
import type { ListItemProps } from "astro-portabletext/types";
import Sparkle from "reicon-astro/icons/Sparkle.astro";

type Props = ListItemProps;
---

<li class="flex gap-2.5 text-pretty">
  <Sparkle class="mt-[.3em] size-4 shrink-0 text-accent" aria-hidden="true" />
  <span class="min-w-0 flex-1">
    <slot />
  </span>
</li>
