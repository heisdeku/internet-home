---
import { sanityClient } from 'sanity:client';
import ArrowRight from 'reicon-astro/icons/ArrowRight.astro';
import ArrowUpRight from 'reicon-astro/icons/ArrowUpRight.astro';
import PortableText from '@/components/portable-text/PortableText.astro';
import SanityImage from '@/components/SanityImage.astro';
import Site from '@/layouts/Site.astro';
import { buildMeta, siteOrigin } from '@/lib/seo';
import { breadcrumbNode, creativeWorkNode, siteGraph, webPageNode } from '@/lib/structuredData';
import { SITE_SETTINGS_QUERY, WORK_QUERY } from '@/sanity/queries';

export async function getStaticPaths() {
	const { sanityClient } = await import('sanity:client');
	const { WORK_SLUGS_QUERY } = await import('@/sanity/queries');
	const slugs = await sanityClient.fetch(WORK_SLUGS_QUERY);
	const number = (i: number) => String(i + 1).padStart(2, '0');
	return slugs.map(({ slug }, i) => {
		const nextIndex = (i + 1) % slugs.length;
		return {
			params: { slug },
			props: { number: number(i), next: slugs[nextIndex].slug, nextNumber: number(nextIndex) },
		};
	});
}

interface Props {
	number: string;
	next: string;
	nextNumber: string;
}

const { number, next, nextNumber } = Astro.props;
const { slug } = Astro.params;
const [work, nextWork, settings] = await Promise.all([
	sanityClient.fetch(WORK_QUERY, { slug }),
	sanityClient.fetch(WORK_QUERY, { slug: next }),
	sanityClient.fetch(SITE_SETTINGS_QUERY),
]);
if (!work || !nextWork || !settings) return Astro.rewrite('/404');

const path = `/work/${work.slug}`;
const origin = siteOrigin(settings, Astro.site, Astro.url);
const meta = buildMeta({ settings, origin, path, seo: work.seo, title: work.title, description: work.summary, og: { kind: 'work', slug: work.slug ?? '' } });
const jsonLd = [
	...siteGraph(origin, settings),
	webPageNode({ origin, path, name: meta.title, description: meta.description, updatedAt: work._updatedAt }),
	creativeWorkNode({ origin, path, type: 'CreativeWork', name: work.title ?? '', description: work.summary, url: work.url, updatedAt: work._updatedAt }),
	breadcrumbNode(origin, [{ name: 'Home', path: '/' }, { name: 'Selected Works', path: '/#works' }, { name: work.title ?? '', path }]),
];

const gallery = work.gallery ?? [];
---

<Site meta={meta} jsonLd={jsonLd} settings={settings}>
	<main class="px-gutter">
		<section data-reveal-stagger class="flex flex-col gap-7 pt-[clamp(56px,9vw,128px)] pb-[clamp(40px,5vw,72px)]">
			<div class="flex flex-wrap gap-3 text-[13px] text-muted">
				<a href="/#works" class="text-muted">Selected Works</a>
				<span>/</span>
				<span class="font-mono">N°{number}</span>
			</div>
			<h1 class="text-[clamp(44px,8vw,128px)] leading-[.95] font-medium tracking-[-.045em]">{work.title}</h1>
		</section>

		<section data-reveal-stagger class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6 border-y border-line py-5 text-sm">
			<div class="flex flex-col gap-1.5"><span class="label">Role</span><span>{work.role}</span></div>
			<div class="flex flex-col gap-1.5"><span class="label">Year</span><span>{work.year}</span></div>
			<div class="flex flex-col gap-1.5"><span class="label">Stack</span><span>{work.stack ?? 'TBC'}</span></div>
			{
				work.url && (
					<div class="flex flex-col gap-1.5">
						<span class="label">Live</span>
						<a href={work.url} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 font-medium text-accent">
							Visit site <ArrowUpRight class="icon-inline" style="--icon-nudge:translate(3px,-3px)" />
						</a>
					</div>
				)
			}
		</section>

		<SanityImage
			image={work.heroImage}
			placeholder={`${work.slug} — hero image / video`}
			width={1600}
			height={900}
			loading="eager"
			class="my-[clamp(24px,3vw,40px)] aspect-video w-full"
			data-reveal
		/>

		<section data-reveal-stagger class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-12 py-[clamp(48px,6vw,96px)]">
			<h2 class="text-[13px] font-medium">Overview</h2>
			<p class="col-span-2 max-w-[36ch] text-[clamp(20px,2vw,28px)] leading-[1.35] tracking-[-.015em] text-pretty">
				{work.summary}
			</p>
		</section>

		{
			work.scope && work.scope.length > 0 && (
				<section data-reveal-stagger class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-12 pb-[clamp(48px,6vw,96px)]">
					<h2 class="text-[13px] font-medium">Scope</h2>
					<div class="col-span-2 flex flex-col">
						{work.scope.map((item, i) => (
							<div class="grid grid-cols-[48px_1fr] gap-4 border-b border-line py-4.5 text-base">
								<span class="pt-0.75 font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
								<span>{item}</span>
							</div>
						))}
					</div>
				</section>
			)
		}

		<section
			data-reveal-stagger
			class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[clamp(16px,2vw,24px)] pb-[clamp(64px,8vw,120px)]"
		>
			{
				(gallery.length > 0 ? gallery : [null, null]).map((image, i) => (
					<SanityImage
						image={image}
						placeholder={`gallery ${String(i + 1).padStart(2, '0')}`}
						width={960}
						height={1200}
						class="aspect-4/5 w-full"
					/>
				))
			}
		</section>
	</main>

	<a
		href={`/work/${nextWork.slug}`}
		class="group px-gutter flex flex-col gap-3 bg-accent py-[clamp(56px,8vw,112px)] text-white transition-colors hover:bg-accent-dark hover:text-white"
	>
		<span class="text-[13px] text-accent-pale">Next project — N°{nextNumber}</span>
		<span class="inline-flex items-center gap-[.2em] text-[clamp(36px,6vw,96px)] leading-none font-medium tracking-[-.04em]">
			{nextWork.title} <ArrowRight class="icon-inline size-[.8em]" style="--icon-nudge:translateX(.15em)" />
		</span>
	</a>
</Site>
