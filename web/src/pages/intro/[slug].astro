---
import { sanityClient } from 'sanity:client';
import Page from '@/components/Page.astro';
import { OUTREACH_QUERY } from '@/sanity/queries';

export async function getStaticPaths() {
	const { sanityClient } = await import('sanity:client');
	const { OUTREACH_SLUGS_QUERY } = await import('@/sanity/queries');
	const pages = await sanityClient.fetch(OUTREACH_SLUGS_QUERY);
	return pages.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = await sanityClient.fetch(OUTREACH_QUERY, { slug });
if (!page) return Astro.rewrite('/404');
---

<Page page={page} />
