---
import { sanityClient } from "sanity:client";
import Page from "@/components/Page.astro";
import { OUTREACH_QUERY } from "@/sanity/queries";

// Intro pages are created in the Studio between deploys, so render them on request.
export const prerender = false;

const { slug } = Astro.params;
const page = await sanityClient.fetch(OUTREACH_QUERY, { slug });
// An on-demand route cannot rewrite to the prerendered 404 page; a 404 response serves it instead.
if (!page) return new Response(null, { status: 404 });
---

<Page page={page} />
