---
import Cta from "@/components/Cta.astro";
import SanityImage from "@/components/SanityImage.astro";
import Site from "@/layouts/Site.astro";
import { serial } from "@/lib/format";
import { STATUS_LABEL } from "@/lib/productStatus";
import { buildMeta, siteOrigin } from "@/lib/seo";
import {
  breadcrumbNode,
  creativeWorkNode,
  siteGraph,
  webPageNode,
} from "@/lib/structuredData";
import { pathFor } from "@/sanity/links";
import { PRODUCT_QUERY, SITE_SETTINGS_QUERY } from "@/sanity/queries";
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  const { sanityClient } = await import("sanity:client");
  const { PRODUCT_SLUGS_QUERY } = await import("@/sanity/queries");
  const products = await sanityClient.fetch(PRODUCT_SLUGS_QUERY);
  return products.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [product, settings] = await Promise.all([
  sanityClient.fetch(PRODUCT_QUERY, { slug }),
  sanityClient.fetch(SITE_SETTINGS_QUERY),
]);
if (!settings)
  throw new Error(
    "Site Settings document is missing. Create it in the Studio.",
  );
if (!product) return Astro.rewrite("/404");

const path = pathFor("product", product.slug);
const origin = siteOrigin(settings, Astro.site, Astro.url);

const meta = buildMeta({
  settings,
  origin,
  path,
  seo: product.seo,
  title: product.name,
  description: product.tagline,
  og: { kind: "product", slug: product.slug },
});

const jsonLd = [
  ...siteGraph(origin, settings),
  webPageNode({
    origin,
    path,
    name: meta.title,
    description: meta.description,
    updatedAt: product._updatedAt,
  }),
  creativeWorkNode({
    origin,
    path,
    type: "SoftwareApplication",
    name: product.name,
    description: product.tagline,
    updatedAt: product._updatedAt,
  }),
  breadcrumbNode(origin, [
    { name: "Home", path: "/" },
    { name: "Products", path: "/products" },
    { name: product.name, path },
  ]),
];
---

<Site meta={meta} jsonLd={jsonLd} settings={settings}>
  <main id="main" class="px-gutter">
    <section
      data-reveal-stagger
      class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-end gap-10 pt-[clamp(56px,9vw,128px)] pb-[clamp(40px,5vw,64px)]"
    >
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-2.5 font-mono text-xs">
          <span class="rounded-sm bg-accent px-2 py-1 text-white">
            {STATUS_LABEL[product.status]}
          </span>
          <span class="text-muted">
            Product{product.version && ` · ${product.version}`}
          </span>
        </div>
        <h1 class="text-[clamp(44px,8vw,120px)] leading-[.95] font-medium tracking-[-.045em]">
          {product.name}
        </h1>
      </div>
      <div class="flex flex-col gap-6">
        <p class="max-w-[36ch] text-[clamp(18px,1.6vw,22px)] leading-[1.4] text-body text-pretty">
          {product.tagline}
        </p>
        {product.ctas && product.ctas.length > 0 && (
          <div class="flex flex-wrap gap-2.5">
            {product.ctas.map((cta) => (
              <Cta cta={cta} resumeUrl={settings.resumeUrl} />
            ))}
          </div>
        )}
      </div>
    </section>

    <div data-reveal class="rounded-md bg-ink p-[clamp(16px,3vw,40px)]">
      <SanityImage
        image={product.preview}
        placeholder="product preview — video / screenshot"
        width={1600}
        height={900}
        priority
        sizes="100vw"
        dark
        class="aspect-video w-full"
      />
    </div>

    {product.features && product.features.length > 0 && (
      <section
        data-reveal-stagger
        class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-[clamp(24px,3vw,40px)] py-[clamp(64px,8vw,120px)]"
      >
        {product.features.map((feature, i) => (
          <div class="flex flex-col gap-3 border-t border-ink pt-4.5">
            <span class="font-mono text-xs text-accent">N°{serial(i)}</span>
            <span class="text-xl font-medium tracking-[-.015em]">
              {feature.title}
            </span>
            <span class="text-[15px] leading-normal text-muted text-pretty">
              {feature.description}
            </span>
          </div>
        ))}
      </section>
    )}

    {product.changelog && product.changelog.length > 0 && (
      <section
        data-reveal-stagger
        class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-12 border-t border-line py-[clamp(48px,6vw,96px)]"
      >
        <h2 class="text-[13px] font-medium">Changelog</h2>
        <div class="col-span-2 flex flex-col">
          {product.changelog.map((entry) => (
            <div class="grid grid-cols-[120px_minmax(0,1fr)] gap-4 border-b border-line py-4.5 text-[15px]">
              <span class="pt-0.5 font-mono text-xs text-faint">
                {entry.version} — {entry.date.slice(0, 4)}
              </span>
              <span class="text-pretty">{entry.note}</span>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</Site>
