{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "a11y": "node scripts/a11y.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.10.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "astro-portabletext": "^1.0.1",
    "groq": "^6.20.0",
    "lenis": "^1.3.27",
    "reicon-astro": "^1.0.1",
    "satori": "^0.63.2",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/global.css",
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
